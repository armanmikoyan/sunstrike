{
  "name": "chronolab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chronolab/lab",
    "dev:lab": "npm run dev --workspace @chronolab/lab",
    "build": "npm run build --workspace @chronolab/lab",
    "start": "npm run start --workspace @chronolab/lab --",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "npm run test:unit --workspace @chronolab/lab --",
    "test:components": "npm run test:components --workspace @chronolab/lab --",
    "test:coverage": "npm run test:coverage --workspace @chronolab/lab",
    "test:e2e": "npm run test:e2e --workspace @chronolab/lab",
    "test:e2e:ui": "npm run test:e2e:ui --workspace @chronolab/lab",
    "test:e2e:install": "npm run test:e2e:install --workspace @chronolab/lab",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,md,mdx}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
