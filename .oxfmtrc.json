{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.next-e2e/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/out/**",
    "**/build/**",
    "**/public/**",
    ".agents/**",
    "**/next-env.d.ts"
  ]
}
