{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "react", "nextjs", "jsx-a11y", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "next": {
      "rootDir": "apps/lab/"
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.next-e2e/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/out/**",
    "**/build/**",
    "**/public/**",
    ".agents/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["apps/engine/**/*.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["apps/engine/src/**/*.ts"],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    },
    {
      "files": ["apps/engine/src/**/*.ts"],
      "excludeFiles": ["apps/engine/src/app.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/modules/*/*", "**/modules/*/*"],
                "message": "Import a module through its index.ts only. Only app.ts may import a module's router.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.e2e.ts"],
      "rules": {
        "no-shadow": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.e2e.ts", "apps/lab/vitest.setup.tsx"],
      "rules": {
        "no-constant-binary-expression": "off",
        "unicorn/consistent-function-scoping": "off",
        "no-unused-vars": [
          "warn",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ]
      }
    }
  ]
}
