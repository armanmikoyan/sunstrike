# Engine runtime configuration. Copy to .env and fill in.
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Postgres connection string for the Supabase project.
DATABASE_URL=

# Supabase project used to verify Auth sessions. The anon key is safe to use
# here; the service-role key, if added later, must stay server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
