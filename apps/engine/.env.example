# Engine runtime configuration. Copy to .env and fill in.
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Log level for pino: trace, debug, info, warn, error or fatal.
# Defaults to debug in development and info in production.
LOG_LEVEL=debug

# Postgres connection string for the Supabase project.
DATABASE_URL=

# Supabase project used to verify Auth sessions. Use the publishable key
# (sb_publishable_...). Never put the secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Runware API key used by the catalog to sync model availability.
RUNWARE_API_KEY=
