# Lab runtime configuration. Copy to .env.local and fill in.
SITE_URL=http://localhost:3000
NODE_ENV=development

# Public Google OAuth client id used by Google One Tap. Must match the Google
# provider configured in Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The lab talks to the engine only from its server-side BFF. The browser never
# receives this value.
ENGINE_URL=http://localhost:4000
