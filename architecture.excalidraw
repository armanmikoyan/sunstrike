    {
      "id": "xhLjGhxWfTYXzzX2EIdu1",
      "type": "text",
      "x": -327.4469205750379,
      "y": 2522.4006599178897,
      "width": 4228,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
