      "text": "• Stores application records.\n• Persists queued generation jobs.",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Stores application records.\n• Persists queued generation jobs.",
